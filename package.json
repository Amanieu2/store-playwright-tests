{
  "name": "store-playwright-tests",
  "version": "1.0.0",
  "private": true,
  "description": "E2E UI and API test automation with Playwright and TypeScript",
  "author": "Petr Kusevich",
  "license": "MIT",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:api": "playwright test --project=api",
    "test:smoke": "playwright test --grep @smoke",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "zod": "4.6.7"
  }
}
